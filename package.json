    "test:signup": "node test/client-signup-test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "xlsx": "^0.18.5"
  }
}
