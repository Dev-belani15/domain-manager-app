{
  "name": "domain-manager-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "start:server": "node server/index.js",
    "create-admin": "node server/cli/create-admin.js",
